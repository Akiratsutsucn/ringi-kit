%% {{ doc.figure["ad-topology"].number }} {{ doc.figure["ad-topology"].title }}（数据来源：project.yaml current_state.domains、cloud_tenants、rollout）
flowchart LR
{% if project.project_type == "admerge" %}
{% set target = current_state.domains[0] %}
  subgraph SRC["现状：源林"]
{% for d in current_state.domains %}
    D{{ loop.index }}["林 {{ d.forest | mm }}<br/>{{ d.name | mm }}<br/>域控 {{ d.dc_count }} 台"]
{% endfor %}
  end
  subgraph TGT["目标：统一后的林"]
    T1["目标林 {{ target.forest | mm }}<br/>统一登录名与组策略基线"]
  end
  subgraph CLOUD["云侧（本次不合并）"]
{% for t in current_state.tenants %}
    C{{ loop.index }}["租户 {{ t.name | mm }}<br/>用户 {{ t.user_count }}<br/>{{ t.sync_label | mm }}"]
{% endfor %}
  end
{% for d in current_state.domains %}
{% if not loop.first %}
  D{{ loop.index }} ==>|用户与计算机迁入；迁移期间保留林间信任| T1
{% endif %}
{% endfor %}
  D1 -->|保留并扩展| T1
{% for t in current_state.tenants %}
  T1 -.->|同步关系按租户保持| C{{ loop.index }}
{% endfor %}
{% else %}
  subgraph ONP["现状：本地目录"]
{% for d in current_state.domains %}
    D{{ loop.index }}["{{ d.name | mm }}<br/>域控 {{ d.dc_count }} 台"]
{% endfor %}
  end
  subgraph CLOUD["目标：云租户"]
{% for t in current_state.tenants %}
    C{{ loop.index }}["租户 {{ t.name | mm }}<br/>用户 {{ t.user_count }}<br/>现状：{{ t.sync_label | mm }}"]
{% endfor %}
  end
{% for d in current_state.domains %}
{% for t in current_state.tenants %}
  D{{ loop.index }} ==>|用户与组单向同步，本地为准| C{{ loop.index }}
{% endfor %}
{% endfor %}
{% endif %}
